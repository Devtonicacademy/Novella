# -------------------------------------------------------------
# Paystack Live / Test API Keys
# -------------------------------------------------------------
# Get these from Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Project identifier prefix for Paystack reference tracking (e.g. NOV_ for Novella)
# This lets you easily search & filter payments for this specific website on your Paystack dashboard
PAYSTACK_PROJECT_PREFIX=NOV_

# -------------------------------------------------------------
# Gemini AI Studio Key (Optional - for AI Story & Writing Suite)
# -------------------------------------------------------------
GEMINI_API_KEY=
